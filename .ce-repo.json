{
  "name": "robogen",
  "version": {
    "file": "scripts/robogen/core.py",
    "pattern": "(?m)^VERSION\\s*=\\s*\"([^\"]+)\""
  },
  "check": {
    "quick": [
      [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ]
    ],
    "full": [
      [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      [
        "python3",
        "scripts/testplan.py"
      ]
    ],
    "nightly": [
      [
        "bash",
        "scripts/nightly.sh"
      ]
    ]
  },
  "docs": {
    "changelog": "CHANGELOG.md",
    "dir": "docs"
  },
  "limits": {
    "AGENTS.md": 150,
    "CLAUDE.md": 20
  },
  "release": {
    "branch_prefix": "release/",
    "tag_prefix": "v"
  },
  "heavy_lock": true,
  "coordination": {
    "repo": "ffunkfabian-hash/cubeescape-nexogen",
    "registry": "https://github.com/ffunkfabian-hash/cubeescape-nexogen/blob/main/repos.json"
  },
  "tools_version": {
    "version": "0.22.0",
    "commit": "9f1ed12072c8807d3cd0b26370e792bd4249f762"
  },
  "tidy": {
    "paths": [
      {
        "name": "Stufen-Ausgaben output/_*",
        "root": "output",
        "glob": "_*",
        "keep": 2,
        "older_than_days": 14
      }
    ]
  }
}
