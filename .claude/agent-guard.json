{
  "about": "Werkzeug-Profile der Subagents in .claude/agents (1.18.0; 1.20.2: testplan.py, Werkzeug-Tests, quiet.py status; 1.20.3: heavy_lock.py status, release.py nur als Probelauf). Durchgesetzt vom Plugin ce-shared (Marketplace ce-agent-tools): Bash-Befehle muessen einem Muster in 'bash' entsprechen (oder lesend sein, 'readonly_shell'), Edit/Write nur auf Pfade in 'edit' ausser 'deny_edit' (Globs relativ zum Repository). Aenderungen hier zusammen mit dem Agenten-Text.",
  "agents": {
    "rg-test-runner": {
      "readonly_shell": true,
      "bash": [
        "python3\\s+scripts/testplan\\.py\\b",
        "python3\\s+-m\\s+unittest\\s+discover\\s+-s\\s+tests\\b",
        "python3\\s+scripts/quiet\\.py\\s+status\\b",
        "python3\\s+scripts/heavy_lock\\.py\\s+status\\b",
        "python3\\s+scripts/release\\.py\\s+(?!.*--apply)\\S",
        "[\"']?(/Applications/Blender\\.app/Contents/MacOS/Blender|blender)[\"']?\\s+-b\\b.*--python\\s+scripts/(generate_robot|verify_robot)\\.py\\b",
        "(bash\\s+)?scripts/check_output\\.sh\\b",
        "(bash\\s+)?viewer/(build|test_viewer)\\.sh\\b",
        "(bash\\s+)?unity/run_testbed\\.sh\\b",
        "cp\\s+[\"']?output/(_\\w+/)?logs/robot_report\\.json[\"']?\\s+[\"']?[^\\s\"']+[\"']?$"
      ],
      "edit": []
    },
    "rg-doc-keeper": {
      "readonly_shell": true,
      "bash": [],
      "edit": [
        "README.md",
        "AGENTS.md",
        "CLAUDE.md",
        "CHANGELOG.md",
        "docs/*.md",
        ".agents/skills/README.md",
        ".agents/skills/*/SKILL.md"
      ],
      "deny_edit": []
    }
  }
}
