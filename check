#!/bin/sh
# Thin wrapper: runs the checks of .ce-repo.json (./check = quick, ./check --full). Tools: embedded copy in scripts/ce_tools.
here="$(cd "$(dirname "$0")" && pwd)"
tools="$here/scripts/ce_tools/ce_check.py"
[ -f "$tools" ] || { echo "check: $tools missing - run ce_sync.py (ce-agent-tools) for this repo" >&2; exit 2; }
case "${1:-}" in --full) shift; mode=full ;; *) mode=quick ;; esac
exec python3 "$tools" "$mode" --repo "$here" "$@"
