#!/bin/sh
# Thin wrapper: dry run of the release checks (./release), --execute does it. Robogen's own release.py stays the
# executor (merge, tag, branch, push); this wrapper runs the shared checks first.
here="$(cd "$(dirname "$0")" && pwd)"
tools="$here/scripts/ce_tools/ce_release.py"
[ -f "$tools" ] || { echo "release: $tools missing - run ce_sync.py (ce-agent-tools) for this repo" >&2; exit 2; }
exec python3 "$tools" --repo "$here" "$@"
